# Used by sqlx-cli and `cargo sqlx prepare` (migrations, compile-time query checks)
DATABASE_URL=postgres://trovr:trovr@localhost:5432/trovr

# Used by the trovr application itself (see backend/crates/config)
APP__BIND_ADDR=0.0.0.0:8080
APP__DATABASE_URL=postgres://trovr:trovr@localhost:5432/trovr
APP__LOG_FORMAT=pretty
