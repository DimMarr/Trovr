# Used by sqlx-cli and `cargo sqlx prepare` (migrations, compile-time query checks)
DATABASE_URL=postgres://trovr:trovr@localhost:5432/trovr

# Used by the trovr application itself (see backend/crates/config)
APP__BIND_ADDR=0.0.0.0:8080
APP__DATABASE_URL=postgres://trovr:trovr@localhost:5432/trovr
APP__LOG_FORMAT=pretty

# Auth (see backend/crates/auth). auth_mode is one of: internal, oidc, both.
APP__AUTH_MODE=internal

# RS256 keypair for internally-issued JWTs. Generate once per deployment with:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# The values below are illustrative only (this file is not loaded by the app
# at runtime — nothing reads .env; set real multi-line PEM values via your
# actual environment, e.g. a Kubernetes Secret mounted as an env var).
APP__JWT_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
APP__JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Only required when APP__AUTH_MODE is "oidc" or "both".
APP__OIDC_ISSUER_URL=https://keycloak.example.com/realms/trovr
APP__OIDC_CLIENT_ID=trovr

# Object storage (see backend/crates/storage). Any S3-compatible backend works
# (MinIO, Garage, OVHcloud, AWS S3...). The values below match a local MinIO.
APP__S3_ENDPOINT_URL=http://localhost:9000
# Set only when browsers must reach the backend at a different address than
# the server does (e.g. http://minio:9000 inside docker-compose vs
# http://localhost:9000 from the browser); presigned URLs are signed for it.
# APP__S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
APP__S3_REGION=us-east-1
APP__S3_BUCKET=trovr
APP__S3_ACCESS_KEY_ID=minioadmin
APP__S3_SECRET_ACCESS_KEY=minioadmin
APP__S3_FORCE_PATH_STYLE=true

# API (see backend/crates/api)
# Self-service registration of internal accounts (defaults to false).
APP__AUTH_ALLOW_REGISTRATION=true
# Largest accepted upload in bytes (at most 5 GiB: single presigned PUT).
APP__MAX_UPLOAD_BYTES=5368709120
# Lifetime of presigned upload / download URLs.
APP__UPLOAD_URL_TTL_SECONDS=900
APP__DOWNLOAD_URL_TTL_SECONDS=300
